{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,

    "declaration": false,
    "sourceMap": true,

    "types": [
      "node"
    ]
  },

  "exclude": [
    "node_modules",
    "dist"
  ]
}